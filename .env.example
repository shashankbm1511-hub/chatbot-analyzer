# Optional configuration — copy to `.env` and fill in to enable AI summaries.
# The app runs without any of these values.
#
# 1. pip install -r requirements-optional.txt
# 2. cp .env.example .env   and set your key below
#
# When enabled, the selected transcript is sent to the OpenAI API.
# Only use it with data you are allowed to share with a third party.

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
